<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>artifacts\</OutputPath>
    <LangVersion>latest</LangVersion>

    <AssemblyName>BroStreamerTools</AssemblyName>
    <RootNamespace>BroStreamerTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
  </ItemGroup>

  <PropertyGroup>
    <ObsMappingsGen>$(MSBuildProjectDirectory)\obj\gen\ObsMappings.g.cs</ObsMappingsGen>
  </PropertyGroup>
  <Target Name="GenerateObsMappings" BeforeTargets="CoreCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\Obs\gen-obs-mappings.ps1&quot; -OutFile &quot;$(ObsMappingsGen)&quot;"/>
    <ItemGroup>
      <Compile Include="$(ObsMappingsGen)"/>
    </ItemGroup>
  </Target>
</Project>
